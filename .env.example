# Lunar Navigator backend configuration.
# Copy this file to backend/.env (or project-root .env) and edit as needed.
# No secrets are required: the JPL Horizons API is public.

# development | production
ENVIRONMENT=development

# Browser origins allowed to call the API directly.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173

# Data directory containing data/lola/ldem_75s_240m.img
# DATA_DIR=C:\path\to\lunar-navigator\backend\data

# Optional live cross-check. Set to false for a fully offline demo.
HORIZONS_ENABLED=true
HORIZONS_URL=https://ssd.jpl.nasa.gov/api/horizons.api
HORIZONS_TIMEOUT_SECONDS=20
HORIZONS_CACHE_TTL_SECONDS=86400

# Analysis defaults and safety limits.
DEFAULT_WINDOW_DAYS=7
DEFAULT_STEP_MINUTES=10
MAX_TIMELINE_SAMPLES=5000
